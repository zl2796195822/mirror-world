# Enable the explicit seed identity only for local Next.js development.
MIRROR_DEV_AUTH=true

# Client Projection API base URL for Observer V0.
MIRROR_API_BASE_URL=http://127.0.0.1:3001

# Optional fixed world id. When omitted, Observer uses the first world from /api/v1/worlds.
# MIRROR_WORLD_ID=00000000-0000-4000-8000-0000000000a1
