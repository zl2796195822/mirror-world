{
  "name": "mirror-world",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mirror/db db:generate",
    "db:migrate": "pnpm --filter @mirror/db db:migrate",
    "db:seed": "pnpm --filter @mirror/db db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6"
  }
}
